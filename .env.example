# Copy to .env (gitignored) and fill in. Nothing here is read unless the matching
# provider is actually used — the local Ollama pool and the offline test suite need none of it.

# --- Featherless (remote worker pool, OpenAI-compatible API) -----------------
# Required only for --featherless runs.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Total concurrency units available to this account. Premium = 4.
# The governor sizes its budget from this; see docs/DESIGN.md.
FEATHERLESS_UNIT_BUDGET=4

# --- OpenRouter (remote worker pool, OpenAI-compatible API, per-token billing) ---
# Required only for OpenRouter-backed workers. Every OpenRouter worker is pinned to a specific
# upstream provider (the manifest carries the pin + per-token prices per worker).
OPENROUTER_API_KEY=
# Note the path: /api/v1, not /v1.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Account-wide concurrent-request cap (our politeness bound, not a provider quota — the pinned
# upstreams allow far more). One call = one unit; the governor sizes its budget from this.
OPENROUTER_UNIT_BUDGET=16
# Monthly per-token spend ceiling in USD, enforced fail-closed by the token-spend ledger
# (a separate file from the cloud ledger — GPU rental and token spend are different bills).
# Optional — this is the default. With provider auto-top-up enabled, this ledger is the only
# thing that ever refuses runaway token spend.
CORYPHAEUS_TOKEN_BUDGET_USD=50

# --- Ollama (local worker pool) ---------------------------------------------
# Defaults to Ollama's standard port. Set this if yours differs — on Windows, WinNAT's dynamic port
# range can claim 11434, in which case Ollama ends up somewhere else entirely.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Concurrent Ollama requests. Local VRAM, not an API quota — keep it small.
OLLAMA_UNIT_BUDGET=2

# --- Cloud training (rented GPU for the policy; docs in coryphaeus/docs/CLOUD.md)
# Required for `cloud_run.py --provider runpod`. Created in the RunPod console; env only,
# never committed.
RUNPOD_API_KEY=
# Optional API base override, mostly for tests. v2 is current; v1 carries a retirement notice.
RUNPOD_BASE_URL=https://api.runpod.io/v2
# Required for `cloud_run.py --provider vast`. Same rule: env only, never committed.
VAST_API_KEY=
# Optional API base override, mostly for tests.
VAST_BASE_URL=https://console.vast.ai/api/v0
# Comma-separated Vast host and/or machine ids to refuse when picking offers — the operator's
# scalpel for a host that accepts rentals but never boots, which reliability floors cannot see.
# Ids are recorded in the launcher's "provisioned" events. Session-level by design: a host that
# is broken tonight may be fine next month.
CORYPHAEUS_VAST_EXCLUDE=
# Monthly provisioning ceiling in USD, enforced fail-closed by the append-only budget ledger.
# Optional — this is the default. Raise it deliberately; never hand-edit the ledger instead.
CORYPHAEUS_CLOUD_BUDGET_USD=50
# Optional pair: Telegram push when a run starts/finishes/fails/is refused. Both unset =
# notifications silently off, nothing else changes. Token from @BotFather; chat id from
# messaging your bot once and reading getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SSH private key the launcher uses to reach the rented box (its PUBLIC half must be
# registered with the provider). Optional — this is the default.
CORYPHAEUS_SSH_KEY=~/.ssh/id_ed25519
# Docker image the box boots. Build coryphaeus/cloud/Dockerfile and push it to a registry YOU
# control — this public repo names no registries or accounts. Any image with bash+git+curl also
# works (cloud/bootstrap.sh installs uv and clones the repo itself).
CORYPHAEUS_CLOUD_IMAGE=
# Public https clone URL + ref the rented box trains from. URL defaults to this checkout's
# `origin` remote at runtime; ref defaults to develop.
CORYPHAEUS_REPO_URL=
REPO_REF=

# --- Paths ------------------------------------------------------------------
# Where fetched datasets and run artifacts live. Defaults are repo-relative
# (./data, ./runs); point them at a roomier volume if your system drive is tight.
CORYPHAEUS_DATA_DIR=
CORYPHAEUS_RUNS_DIR=
# Hugging Face cache, if you'd rather it not sit on the system drive.
HF_HOME=
